RESOURCE_STORAGE_ENDPOINT=http://localstack:4566
RESOURCE_STORAGE_REGION=us-east-1
RESOURCE_STORAGE_BUCKET=resources
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=resources
RABBITMQ_PASSWORD=resources
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_INITIAL_DELAY=1000
PUBLISH_MAX_DELAY=5000
PUBLISH_CONFIRM_TIMEOUT=5000
HTTP_MAX_ATTEMPTS=3
HTTP_INITIAL_DELAY=1000
HTTP_MAX_DELAY=5000
HTTP_CONNECT_TIMEOUT=2000
HTTP_READ_TIMEOUT=5000
LISTENER_MAX_ATTEMPTS=5
